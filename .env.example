# Required: web search for the researcher (https://tavily.com)
TAVILY_API_KEY=

# Optional: live prices and the real market-open check. Without it, prices are simulated.
MASSIVE_API_KEY=

# Optional: phone notifications (https://pushover.net)
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Engine timing: minutes between cycles, and whether to trade when the market is closed
RUN_EVERY_N_MINUTES=60
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false

# Optional: only used to upload traces to https://platform.openai.com/traces
OPENAI_API_KEY=
